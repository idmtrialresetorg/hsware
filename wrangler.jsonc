{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hsware-studio",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "not_found_handling": "none" },
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "REPLACE_WITH_HYPERDRIVE_ID" }
  ],
  "r2_buckets": [
    { "binding": "BACKUPS", "bucket_name": "hsware-backups" }
  ],
  "vars": {
    "ADMIN_PATH": "/admin",
    "TRUST_PROXY": "true",
    "LIGHTWAVE_AUTO_UPDATES": "true",
    "LIGHTWAVE_CONCURRENCY": "4",
    "LIGHTWAVE_CRON_BATCHES": "4"
  },
  "triggers": {
    "crons": ["0 */6 * * *", "0 2 * * *"]
  },
  "observability": { "enabled": true }
}
