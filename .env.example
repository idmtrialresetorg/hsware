# Appbit APK Publishing Workspace environment template
# Copy these values into your deployment environment. Never commit real secrets.

NODE_ENV=production
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=appbit
DB_USER=appbit_user
DB_PASSWORD=your_database_password
DB_SSL=false

# Reverse-proxy deployments normally use 1.
TRUST_PROXY=1

# Temporary APK app-open lock timeout. The browser refreshes an active lock every 30 seconds.
WORK_LOCK_TIMEOUT_SECONDS=90

# APK resolver source settings.
APK_RESOLVER_DAILY_PAGES=8
APK_RESOLVER_FULL_PAGES=80
APK_RESOLVER_MAX_ITEMS=50000
APK_RESOLVER_REQUEST_GAP_MS=1400
