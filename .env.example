# HSWare Studio v4.6.0 environment template
# Copy these values into Hostinger Environment Variables. Never commit real secrets.

NODE_ENV=production
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hsware
DB_USER=hsware_user
DB_PASSWORD=your_database_password
DB_SSL=false

# Optional but strongly recommended for WinGet/GitHub discovery and version history.
GITHUB_TOKEN=

# Maximum supported bulk-import target. The UI still lets you choose the amount per job.
CATALOG_TARGET=50000

# Hostinger/reverse proxy deployments normally use 1.
TRUST_PROXY=1

# Temporary software-open lock timeout. The browser refreshes the lock every 30 seconds.
# Keep this above 60 seconds so normal network jitter does not release an active modal.
WORK_LOCK_TIMEOUT_SECONDS=90

# Android source: LiteAPKs public metadata pages. HSWare uses normal public HTTP requests only.
# Daily sync first uses recent sitemap last-modified entries; listing pages are the fallback.
# The first/full sync tries the complete sitemap, then falls back to pagination.
LITEAPKS_DAILY_PAGES=8
LITEAPKS_FULL_PAGES=80
LITEAPKS_MAX_ITEMS=50000
# Minimum delay between LiteAPKs metadata requests (milliseconds).
LITEAPKS_REQUEST_GAP_MS=1400
