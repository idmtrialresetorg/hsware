# Cloudflare Edition: secrets should be set with `npx wrangler secret put NAME`.
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ADMIN_NAME=HSWare Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_PATH=/admin
APP_URL=https://hsware-studio.YOUR_SUBDOMAIN.workers.dev
GITHUB_TOKEN=
LOGO_DEV_API_KEY=
LOGO_DEV_PUBLISHABLE_KEY=
BRANDFETCH_CLIENT_ID=
LIGHTWAVE_AUTO_UPDATES=true
LIGHTWAVE_CONCURRENCY=4
LIGHTWAVE_CRON_BATCHES=4
TRUST_PROXY=true
# Database credentials are NOT stored here on Cloudflare.
# They are kept inside the HYPERDRIVE binding.
