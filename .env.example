NODE_ENV=production
SESSION_SECRET=GENERATE_A_RANDOM_SECRET_MIN_32_CHARACTERS
ADMIN_NAME=Admin
ADMIN_EMAIL=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME
ADMIN_RECOVERY_MODE=false
ADMIN_PATH=/admin
DB_HOST=CHANGE_ME
DB_PORT=3306
DB_NAME=CHANGE_ME
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
GITHUB_TOKEN=
# Logo.dev direct Logo API publishable key (pk_...). Used for verified 800px WebP product logos.
LOGO_DEV_PUBLISHABLE_KEY=

# Logo.dev Search API secret key (sk_...). Strongly recommended: enables five-strategy exact product matching before a logo is accepted.
LOGO_DEV_API_KEY=

# Optional free Brandfetch Brand Search client ID. HSWare uses Search only as an identity/domain cross-check for Logo.dev.
# It does NOT cache or redistribute Brandfetch Logo API assets.
BRANDFETCH_CLIENT_ID=
CATALOG_TARGET=50000
TRUST_PROXY=1
WORK_LOCK_TIMEOUT_SECONDS=90
# Google Drive automatic JSON backup (optional)
APP_URL=https://your-domain.example
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Leave blank to use APP_URL + /api/backups/google/callback
GOOGLE_DRIVE_REDIRECT_URI=


# LightWave Update Center: published software only. Sleeps between scheduled checks.
LIGHTWAVE_AUTO_UPDATES=true
LIGHTWAVE_INTERVAL_HOURS=6
# Small bounded parallel batch; raise cautiously on stronger hosting (1-8).
LIGHTWAVE_CONCURRENCY=4
# Pause between bounded batches only while a scan is actively running.
LIGHTWAVE_ACTIVE_DELAY_MS=750
