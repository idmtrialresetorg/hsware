<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>HSWare Health</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet"><link rel="stylesheet" href="/css/app.css?v=<%= appVersion %>"></head><body class="standalone"><div class="health-card"><div class="brand-row login-brand"><div class="brand-mark">HS</div><div><div class="brand-title">HSWare Studio Health</div><div class="brand-sub">Safe configuration checks — secrets are never shown.</div></div></div><table class="health-table"><thead><tr><th>Check</th><th>Status</th><th>Details</th></tr></thead><tbody><% checks.forEach(c => { %><tr><td><%= c[0] %></td><td><span class="status-pill <%= c[1]?'ok':'bad' %>"><%= c[1]?'PASS':'ACTION' %></span></td><td><%= c[2] %></td></tr><% }) %></tbody></table><div class="health-actions"><a class="btn btn-primary" href="<%= state.dbReady ? '/' : '/health' %>"><%= state.dbReady ? 'Open Studio' : 'Retry Health' %></a></div></div></body></html>
