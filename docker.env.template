# Copy this file to .env.docker before running Docker Compose.
# Keep .env.docker private; the existing .gitignore already ignores .env.* files.

# IMPORTANT FOR LOCAL HTTP:
# Keep development here so cookie-session does not require HTTPS Secure cookies.
NODE_ENV=development
PORT=3000

SESSION_SECRET=replace-this-with-a-long-random-string-at-least-32-characters
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password

# Appbit database connection. DB_HOST is also forced to the Compose service name "db".
DB_HOST=db
DB_PORT=3306
DB_NAME=appbit
DB_USER=appbit_user
DB_PASSWORD=change-this-database-password
DB_SSL=false

# MySQL container bootstrap. Keep these DB values in sync with the Appbit DB_* values above.
MYSQL_DATABASE=appbit
MYSQL_USER=appbit_user
MYSQL_PASSWORD=change-this-database-password
MYSQL_ROOT_PASSWORD=change-this-root-database-password

TRUST_PROXY=0
WORK_LOCK_TIMEOUT_SECONDS=90

# LiteAPKs / APK resolver settings already used by Appbit.
APK_RESOLVER_DAILY_PAGES=8
APK_RESOLVER_FULL_PAGES=80
APK_RESOLVER_MAX_ITEMS=50000
APK_RESOLVER_REQUEST_GAP_MS=1400
