---
const allowed = new Set(['desktop','android','software','published','updates','settings']);
const path = Astro.params.path || '';
if (path && !allowed.has(path)) return Astro.redirect('/');
const appVersion = '4.6.0';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <title>HSWare Studio — Software Operations</title>
    <meta name="description" content="HSWare Studio software research, publishing and update workspace." />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href={`/ui/app.css?v=${appVersion}`} />
  </head>
  <body>
    <div id="app"><div class="boot">Loading HSWare Studio…</div></div>
    <script src={`/ui/app.js?v=${appVersion}`} defer></script>
  </body>
</html>
